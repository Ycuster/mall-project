{"file":"products-Be7GRTfZ.js","mappings":";;;;;;;;;;;;;;;;;;;;;;AA4IA,MAAM,eAAe;;;;;;;;;;;;;;;;;;;;;;;;;;;AArDrB,UAAM,QAAQ;AAsBd,UAAM,OAAO;AASb,UAAM,UAAU,IAAI,MAAM,UAAU;AACpC,UAAM,UAAU,SAAS;AAAA,MACvB,aAAa,MAAM;AAAA,MACnB,MAAM,MAAM;AAAA,IAAA,CACb;AAED,UAAM,MAAM,MAAM,YAAY,CAAC,QAAQ;AACrC,cAAQ,QAAQ;AAAA,IAClB,CAAC;AAED,UAAM,MAAM,MAAM,YAAY,CAAC,QAAQ;AACrC,cAAQ,cAAc;AAAA,IACxB,CAAC;AAED,UAAM,MAAM,MAAM,QAAQ,CAAC,QAAQ;AACjC,cAAQ,OAAO;AAAA,IACjB,CAAC;AAED,UAAM,SAAS,CAAC,QAAQ;AACtB,WAAK,qBAAqB,GAAG;AAAA,IAC/B,CAAC;AAGD,QAAI,cAAoD;AAExD,aAAS,cAAoB;AAC3B,UAAI,0BAA0B,WAAW;AACzC,oBAAc,WAAW,MAAM;AAC7B,aAAK,UAAU,QAAQ,KAAK;AAAA,MAC9B,GAAG,YAAY;AAAA,IACjB;AAEA,aAAS,eAAqB;AAC5B,UAAI,0BAA0B,WAAW;AACzC,WAAK,UAAU,QAAQ,KAAK;AAAA,IAC9B;AAEA,aAAS,cAAoB;AAC3B,WAAK,OAAO;AAAA,IACd;AAEA,aAAS,qBAA2B;AAClC,WAAK,qBAAqB,QAAQ,WAAW;AAC7C,WAAK,iBAAiB,EAAE,GAAG,SAAS;AAAA,IACtC;AAEA,aAAS,mBAAyB;AAChC,WAAK,iBAAiB,QAAQ,IAAI;AAClC,WAAK,iBAAiB,EAAE,GAAG,SAAS;AAAA,IACtC;;;;;;;AAtKO,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,gBAAY,MAAA,CAAA,CAAA,mBAAA;;oBAEV,QAAA;AAAA,2CAAA,QAAO,QAAA;AAAA,QACf,aAAa,QAAA;AAAA,QACb,WAAW,QAAA;AAAA,QACZ,OAAM;AAAA,QACL,SAAO;AAAA,QACP,SAAa;AAAA,QACb,SAAO;AAAA,MAAA;QAEG,gBAAX,CAEW,GAAAC,QAAAC,UAAA,aAAA;;;+BADT,CAA6BC,IAAAF,QAAAC,UAAAE,cAAA;;;;;oBAApBC,YAAU,iBAAA;AAAA,kBAAA;AAAA;;;;;;cAAnBA,YAA6B,oBAAA,MAAA;AAAA,iCAApB,MAAU;AAAA,kBAAVA,YAAU,iBAAA;AAAA,gBAAA;;;;;;;;QAEG,QAAA;gBAAb;AAAA,sBAAX,CAQW,GAAAJ,QAAAC,UAAA,aAAA;;;gBANP,SAAQ;AAAA,gBACP,SAAS,QAAA;AAAA,gBACT,SAAO;AAAA,cAAA;iCAHV,CAMaC,IAAAF,QAAAC,UAAAE,cAAA;;;;;sCAFZ,MAED;AAAA,oBAAA;AAAA;;;;;;gBANAC,YAMaC,aAAA;AAAA,kBALX,SAAQ;AAAA,kBACP,SAAS,QAAA;AAAA,kBACT,SAAO;AAAA,gBAAA;mCACT,MAED;AAAA,oCAFC,MAED;AAAA,kBAAA;;;;;;;;;UAIO,QAAA,aAAW;;;UAET,YAAA,QAAQ;AAAA,UAAR,uBAAA,CAAA,WAAA,QAAQ,cAAW;AAAA,UAC3B,aAAa,QAAA;AAAA,UACd,WAAA;AAAA,UACC,UAAQ;AAAA,QAAA;2BAJX,CAYY,GAAAL,QAAAC,UAAA,aAAA;;;AALMK,4BAAA,QAAA,aAAP,QAAG;;kBACT,KAAK,IAAI;AAAA,kBACT,OAAO,IAAI;AAAA,kBACX,OAAO,IAAI;AAAA,gBAAA;;;;;kCAJdC,YAKEC,UAAA,MAAAC,WAJc,QAAA,YAAU,CAAjB,QAAG;sCADZF,YAKE,sBAAA;AAAA,oBAHC,KAAK,IAAI;AAAA,oBACT,OAAO,IAAI;AAAA,oBACX,OAAO,IAAI;AAAA,kBAAA;;;;;;;;UAKL,YAAA,QAAQ;AAAA,UAAR,uBAAA,CAAA,WAAA,QAAQ,OAAI;AAAA,UACpB,aAAa,QAAA;AAAA,UACb,UAAQ;AAAA,QAAA;2BAHX,CAWY,GAAAP,QAAAC,UAAA,aAAA;;;AALMK,4BAAA,QAAA,cAAP,QAAG;;kBACT,KAAK,IAAI;AAAA,kBACT,OAAO,IAAI;AAAA,kBACX,OAAO,IAAI;AAAA,gBAAA;;;;;kCAJdC,YAKEC,UAAA,MAAAC,WAJc,QAAA,aAAW,CAAlB,QAAG;sCADZF,YAKE,sBAAA;AAAA,oBAHC,KAAK,IAAI;AAAA,oBACT,OAAO,IAAI;AAAA,oBACX,OAAO,IAAI;AAAA,kBAAA;;;;;;;;;;;UAKP,QAAA,iBAAe;sIACiB,QAAA,KAAK,CAAA,oBAAA;AAAA;;;;;;;;;;;;;;;;;;;ACJpD,UAAM,QAAQ,SAAA;AAEd,eAAW;AAAA,MACT,OAAO;AAAA,MACP,aAAa;AAAA,MACb,UAAU;AAAA,IAAA,CACX;AAED,UAAM,cAA4B;AAAA,MAChC,EAAE,OAAO,QAAQ,OAAO,SAAA;AAAA,MACxB,EAAE,OAAO,QAAQ,OAAO,QAAA;AAAA,MACxB,EAAE,OAAO,QAAQ,OAAO,YAAA;AAAA,MACxB,EAAE,OAAO,QAAQ,OAAO,aAAA;AAAA,IAAa;AAGvC,UAAM,UAAU,SAA6B;AAAA,MAC3C,SAAU,MAAM,MAAM,WAAsB;AAAA,MAC5C,aAAa,MAAM,MAAM,WAAW,OAAO,MAAM,MAAM,QAAQ,IAAI;AAAA,MACnE,MAAO,MAAM,MAAM,QAAmB;AAAA,MACtC,MAAM;AAAA,MACN,UAAU;AAAA,IAAA,CACX;AAED,UAAM,WAAW,IAAe,EAAE;AAClC,UAAM,aAAa,IAAgB,EAAE;AACrC,UAAM,QAAQ,IAAY,CAAC;AAC3B,UAAM,UAAU,IAAa,KAAK;AAElC,mBAAe,KAAK,MAA8B;AAChD,UAAI,cAAc,OAAO;AACzB,cAAQ,QAAQ;AAChB,YAAM,EAAE,KAAA,IAAS,WAAA;AACjB,YAAM,SAAkC,EAAE,GAAG,QAAA;AAC7C,aAAO,KAAK,MAAM,EAAE,QAAQ,CAAA,MAAK;AAAE,YAAI,OAAO,CAAC,MAAM,MAAM,OAAO,CAAC,MAAM,KAAM,QAAO,OAAO,CAAC;AAAA,MAAE,CAAC;AACjG,YAAM,MAAM,MAAM,KAAK,IAAyB,aAAa,EAAE,QAAQ;AACvE,UAAI,IAAI,SAAS,KAAK;AACpB,iBAAS,QAAQ,IAAI,KAAK;AAC1B,cAAM,QAAQ,IAAI,KAAK;AAAA,MACzB;AACA,cAAQ,QAAQ;AAAA,IAClB;AAEA,mBAAe,iBAAgC;AAC7C,YAAM,EAAE,KAAA,IAAS,WAAA;AACjB,YAAM,MAAM,MAAM,KAAK,IAAgB,aAAa;AACpD,UAAI,IAAI,SAAS,IAAK,YAAW,QAAQ,IAAI;AAAA,IAC/C;AAEA,UAAM,MAAM,MAAM,OAAO,OAAO,MAAM;AACpC,cAAQ,UAAW,EAAE,WAAsB;AAC3C,cAAQ,cAAc,EAAE,WAAW,OAAO,EAAE,QAAQ,IAAI;AACxD,cAAQ,OAAQ,EAAE,QAAmB;AACrC,cAAQ,OAAO;AACf,YAAM,KAAK,CAAC;AAAA,IACd,CAAC;AAED,KAAA,QAAA,SAAA,IAAAG,iBAAA,MAAM,gBAAe;AACrB,KAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,KAAK,CAAC,CAAA;AAEZ,aAAS,aAAa,SAAuB;AAC3C,cAAQ,UAAU;AAClB,WAAK,CAAC;AAAA,IACR;AAEA,aAAS,mBAAmB,YAA8D;AACxF,cAAQ,cAAc,WAAW;AACjC,cAAQ,OAAO,WAAW;AAC1B,WAAK,CAAC;AAAA,IACR;AAEA,aAAS,mBAAmB,SAAwB;AAClD,iBAAW,YAAY,QAAQ,EAAE,EAAE;AAAA,IACrC;AAEA,aAAS,gBAAgB,SAAwB;AAC/C,gBAAU,QAAQ,MAAM,QAAQ,IAAI,QAAQ;AAAA,IAC9C;;;;;;;;AA9HO,YAAA,OAAAZ,eAAAC,WAAA,EAAA,OAAM,oBAAgB,MAAA,CAAA,CAAA,GAAA;;QAChB,QAAO;AAAA,QAAQ,OAAA,EAAA,iBAAA,OAAA;AAAA,MAAA;yBAAxB,CAaU,GAAAC,QAAAC,UAAA,aAAA;;;cAXG,YAAA,QAAQ;AAAA,cAAR,uBAAA,CAAA,WAAA,QAAQ,UAAO;AAAA,cAChB,eAAa,QAAQ;AAAA,cAAR,uBAAA,CAAA,WAAA,QAAQ,cAAW;AAAA,cAChC,WAAS,QAAQ;AAAA,cAAR,mBAAA,CAAA,WAAA,QAAQ,OAAI;AAAA,cAC5B,YAAY,WAAA;AAAA,cACZ,gBAAc;AAAA,cACd,gBAAc;AAAA,cACd,qBAAmB;AAAA,cACnB,OAAO,MAAA;AAAA,cACP,UAAQ;AAAA,cACR,gBAAe;AAAA,YAAA;;;cAVlBG,YAWEO,MAAA,SAAA,GAAA;AAAA,gBAVS,YAAA,QAAQ;AAAA,gBAAR,uBAAA,CAAA,WAAA,QAAQ,UAAO;AAAA,gBAChB,eAAa,QAAQ;AAAA,gBAAR,uBAAA,CAAA,WAAA,QAAQ,cAAW;AAAA,gBAChC,WAAS,QAAQ;AAAA,gBAAR,mBAAA,CAAA,WAAA,QAAQ,OAAI;AAAA,gBAC5B,YAAY,WAAA;AAAA,gBACZ,gBAAc;AAAA,gBACd,gBAAc;AAAA,gBACd,qBAAmB;AAAA,gBACnB,OAAO,MAAA;AAAA,gBACP,UAAQ;AAAA,gBACR,gBAAe;AAAA,cAAA;;;;;;iFAIJ,QAAA,KAAO,CAAA,CAAA,GAAA;AACP,UAAA,SAAA,MAAS,QAAM;AAAG,cAAAC,mBAAA,mBAAA,EAAA,QAAQ,MAAE;AAAA,2BAA1C,CAQS,GAAAZ,QAAAC,UAAA,aAAA;;;AAPaK,4BAAA,SAAA,QAAL,MAAC;;kBAAe,KAAK,EAAE;AAAA,kBAAK,IAAI;AAAA,kBAAK,IAAI;AAAA,kBAAI,IAAI;AAAA,kBAAG,OAAA,EAAA,iBAAA,OAAA;AAAA,gBAAA;mCAAnE,CAMSJ,IAAAF,QAAAC,UAAAE,cAAA;;;wBAJJ,SAAS;AAAA,wBACT,SAAO;AAAA,wBACP,aAAa;AAAA,sBAAA;;;wBAHhBC,YAIEO,MAAA,WAAA,GAAA;AAAA,0BAHC,SAAS;AAAA,0BACT,SAAO;AAAA,0BACP,aAAa;AAAA,wBAAA;;;;;;;;;;kCAJlBJ,YAMSC,UAAA,MAAAC,WANW,SAAA,OAAQ,CAAb,MAAC;sCAAhBF,YAMS,mBAAA;AAAA,oBANsB,KAAK,EAAE;AAAA,oBAAK,IAAI;AAAA,oBAAK,IAAI;AAAA,oBAAI,IAAI;AAAA,oBAAG,OAAA,EAAA,iBAAA,OAAA;AAAA,kBAAA;qCACjE,MAIE;AAAA,sBAJFH,YAIEO,MAAA,WAAA,GAAA;AAAA,wBAHC,SAAS;AAAA,wBACT,SAAO;AAAA,wBACP,aAAa;AAAA,sBAAA;;;;;;;;;;;AAIH,cAAAC,mBAAA,qBAAA,EAAA,aAAY,UAAM,MAAA,OAAA,CAAA;AAAA;;UAG1B,MAAA,SAAS,QAAQ,YAAQ,IAAA;4CAAQ,EAAA,WAAA,QAAA,mBAAA,UAAA,cAAA,QAAgE,CAAA,IAAA;;UAEhG,gBAAc,QAAQ;AAAA,UAAR,wBAAA,CAAA,WAAA,QAAQ,OAAI;AAAA,UACjC,aAAW,QAAQ;AAAA,UACnB,OAAO,MAAA;AAAA,UACR,QAAO;AAAA,UACN,iBAAgB;AAAA,QAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_","_scopeId","_createVNode","BaseButton","_ssrRenderList","_createBlock","_Fragment","_renderList","_withAsyncContext","_unref","_ssrRenderComponent"],"sources":["../../../../components/business/product/SearchBar.vue","../../../../pages/products.vue"],"sourcesContent":["<template>\r\n  <div class=\"search-bar\">\r\n    <el-input\r\n      v-model=\"keyword\"\r\n      :placeholder=\"placeholder\"\r\n      :clearable=\"clearable\"\r\n      class=\"search-bar__input\"\r\n      @input=\"handleInput\"\r\n      @keyup.enter=\"handleSearch\"\r\n      @clear=\"handleClear\"\r\n    >\r\n      <template #prefix>\r\n        <el-icon><Search /></el-icon>\r\n      </template>\r\n      <template #append v-if=\"showSearchButton\">\r\n        <BaseButton\r\n          variant=\"primary\"\r\n          :loading=\"loading\"\r\n          @click=\"handleSearch\"\r\n        >\r\n          搜索\r\n        </BaseButton>\r\n      </template>\r\n    </el-input>\r\n\r\n    <div v-if=\"showFilters\" class=\"search-bar__filters\">\r\n      <el-select\r\n        v-model=\"filters.category_id\"\r\n        :placeholder=\"categoryPlaceholder\"\r\n        clearable\r\n        @change=\"handleFilterChange\"\r\n      >\r\n        <el-option\r\n          v-for=\"cat in categories\"\r\n          :key=\"cat.id\"\r\n          :label=\"cat.name\"\r\n          :value=\"cat.id\"\r\n        />\r\n      </el-select>\r\n\r\n      <el-select\r\n        v-model=\"filters.sort\"\r\n        :placeholder=\"sortPlaceholder\"\r\n        @change=\"handleSortChange\"\r\n      >\r\n        <el-option\r\n          v-for=\"opt in sortOptions\"\r\n          :key=\"opt.value\"\r\n          :label=\"opt.label\"\r\n          :value=\"opt.value\"\r\n        />\r\n      </el-select>\r\n    </div>\r\n\r\n    <div v-if=\"showResultCount\" class=\"search-bar__count\">\r\n      共 <span class=\"search-bar__count-num\">{{ total }}</span> 件商品\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { ref, reactive, watch } from 'vue'\r\nimport BaseButton from '../base/BaseButton.vue'\r\nimport type { Category } from '~/types/product'\r\n\r\nexport interface SortOption {\r\n  label: string\r\n  value: string\r\n}\r\n\r\ninterface SearchBarProps {\r\n  modelValue?: string\r\n  categoryId?: number | ''\r\n  sortBy?: string\r\n  placeholder?: string\r\n  clearable?: boolean\r\n  loading?: boolean\r\n  showSearchButton?: boolean\r\n  showFilters?: boolean\r\n  showResultCount?: boolean\r\n  total?: number\r\n  categories?: Category[]\r\n  sortOptions?: SortOption[]\r\n  categoryPlaceholder?: string\r\n  sortPlaceholder?: string\r\n}\r\n\r\nconst props = withDefaults(defineProps<SearchBarProps>(), {\r\n  modelValue: '',\r\n  categoryId: '',\r\n  sortBy: 'newest',\r\n  placeholder: '搜索商品...',\r\n  clearable: true,\r\n  loading: false,\r\n  showSearchButton: true,\r\n  showFilters: false,\r\n  showResultCount: false,\r\n  total: 0,\r\n  categories: () => [],\r\n  sortOptions: () => [\r\n    { label: '最新上架', value: 'newest' },\r\n    { label: '销量优先', value: 'sales' },\r\n    { label: '价格↑', value: 'price_asc' },\r\n    { label: '价格↓', value: 'price_desc' }\r\n  ],\r\n  categoryPlaceholder: '全部分类',\r\n  sortPlaceholder: '排序方式'\r\n})\r\n\r\nconst emit = defineEmits<{\r\n  (e: 'update:modelValue', value: string): void\r\n  (e: 'update:categoryId', value: number | ''): void\r\n  (e: 'update:sortBy', value: string): void\r\n  (e: 'search', keyword: string): void\r\n  (e: 'clear'): void\r\n  (e: 'filter-change', filters: { category_id: number | ''; sort: string }): void\r\n}>()\r\n\r\nconst keyword = ref(props.modelValue)\r\nconst filters = reactive({\r\n  category_id: props.categoryId as number | '',\r\n  sort: props.sortBy\r\n})\r\n\r\nwatch(() => props.modelValue, (val) => {\r\n  keyword.value = val\r\n})\r\n\r\nwatch(() => props.categoryId, (val) => {\r\n  filters.category_id = val\r\n})\r\n\r\nwatch(() => props.sortBy, (val) => {\r\n  filters.sort = val\r\n})\r\n\r\nwatch(keyword, (val) => {\r\n  emit('update:modelValue', val)\r\n})\r\n\r\nconst debounceTime = 300\r\nlet searchTimer: ReturnType<typeof setTimeout> | null = null\r\n\r\nfunction handleInput(): void {\r\n  if (searchTimer) clearTimeout(searchTimer)\r\n  searchTimer = setTimeout(() => {\r\n    emit('search', keyword.value)\r\n  }, debounceTime)\r\n}\r\n\r\nfunction handleSearch(): void {\r\n  if (searchTimer) clearTimeout(searchTimer)\r\n  emit('search', keyword.value)\r\n}\r\n\r\nfunction handleClear(): void {\r\n  emit('clear')\r\n}\r\n\r\nfunction handleFilterChange(): void {\r\n  emit('update:categoryId', filters.category_id)\r\n  emit('filter-change', { ...filters })\r\n}\r\n\r\nfunction handleSortChange(): void {\r\n  emit('update:sortBy', filters.sort)\r\n  emit('filter-change', { ...filters })\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.search-bar {\r\n  display: flex;\r\n  gap: var(--spacing-md);\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.search-bar__input {\r\n  flex: 1;\r\n  min-width: 280px;\r\n}\r\n\r\n.search-bar__filters {\r\n  display: flex;\r\n  gap: var(--spacing-sm);\r\n}\r\n\r\n.search-bar__filters .el-select {\r\n  width: 140px;\r\n}\r\n\r\n.search-bar__count {\r\n  font-size: var(--font-size-sm);\r\n  color: var(--color-text-secondary);\r\n}\r\n\r\n.search-bar__count-num {\r\n  color: var(--color-primary);\r\n  font-weight: 700;\r\n  font-size: var(--font-size-base);\r\n}\r\n</style>","<template>\r\n  <div class=\"page-container\">\r\n    <el-card shadow=\"never\" style=\"margin-bottom: 20px\">\r\n      <SearchBar\r\n        v-model=\"filters.keyword\"\r\n        v-model:category-id=\"filters.category_id\"\r\n        v-model:sort-by=\"filters.sort\"\r\n        :categories=\"categories\"\r\n        :sort-options=\"sortOptions\"\r\n        :show-filters=\"true\"\r\n        :show-result-count=\"true\"\r\n        :total=\"total\"\r\n        @search=\"handleSearch\"\r\n        @filter-change=\"handleFilterChange\"\r\n      />\r\n    </el-card>\r\n\r\n    <div v-loading=\"loading\">\r\n      <el-row v-if=\"products.length\" :gutter=\"20\">\r\n        <el-col v-for=\"p in products\" :key=\"p.id\" :xs=\"12\" :sm=\"8\" :md=\"6\" style=\"margin-bottom: 20px\">\r\n          <ProductCard\r\n            :product=\"p\"\r\n            @click=\"handleProductClick\"\r\n            @add-to-cart=\"handleAddToCart\"\r\n          />\r\n        </el-col>\r\n      </el-row>\r\n      <el-empty v-else description=\"暂无商品\" />\r\n    </div>\r\n\r\n    <div v-if=\"total > (filters.pageSize ?? 0)\" style=\"display: flex; justify-content: center; margin-top: 24px\">\r\n      <el-pagination\r\n        v-model:current-page=\"filters.page\"\r\n        :page-size=\"filters.pageSize\"\r\n        :total=\"total\"\r\n        layout=\"prev, pager, next, jumper\"\r\n        @current-change=\"load\"\r\n      />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { ref, reactive, watch } from 'vue'\r\nimport { useRoute } from '#app'\r\nimport { ElMessage } from 'element-plus'\r\nimport { ProductCard, SearchBar } from '~/components/business'\r\nimport type { SortOption } from '~/components/business'\r\nimport type { Category, Product, ProductQueryParams } from '~/types/product'\r\nimport type { PageResult } from '~/types/api'\r\n\r\nconst route = useRoute()\r\n\r\nuseSeoMeta({\r\n  title: '商品列表 - MallShop',\r\n  description: '浏览 MallShop 所有商品，按分类、价格、销量筛选',\r\n  keywords: '商品,购物,MallShop,商城'\r\n})\r\n\r\nconst sortOptions: SortOption[] = [\r\n  { label: '最新上架', value: 'newest' },\r\n  { label: '销量优先', value: 'sales' },\r\n  { label: '价格升序', value: 'price_asc' },\r\n  { label: '价格降序', value: 'price_desc' }\r\n]\r\n\r\nconst filters = reactive<ProductQueryParams>({\r\n  keyword: (route.query.keyword as string) || '',\r\n  category_id: route.query.category ? Number(route.query.category) : '',\r\n  sort: (route.query.sort as string) || 'newest',\r\n  page: 1,\r\n  pageSize: 12\r\n})\r\n\r\nconst products = ref<Product[]>([])\r\nconst categories = ref<Category[]>([])\r\nconst total = ref<number>(0)\r\nconst loading = ref<boolean>(false)\r\n\r\nasync function load(page?: number): Promise<void> {\r\n  if (page) filters.page = page\r\n  loading.value = true\r\n  const { $api } = useNuxtApp()\r\n  const params: Record<string, unknown> = { ...filters }\r\n  Object.keys(params).forEach(k => { if (params[k] === '' || params[k] === null) delete params[k] })\r\n  const res = await $api.get<PageResult<Product>>('/products', { params })\r\n  if (res.code === 200) {\r\n    products.value = res.data.list\r\n    total.value = res.data.total\r\n  }\r\n  loading.value = false\r\n}\r\n\r\nasync function loadCategories(): Promise<void> {\r\n  const { $api } = useNuxtApp()\r\n  const res = await $api.get<Category[]>('/categories')\r\n  if (res.code === 200) categories.value = res.data\r\n}\r\n\r\nwatch(() => route.query, async (q) => {\r\n  filters.keyword = (q.keyword as string) || ''\r\n  filters.category_id = q.category ? Number(q.category) : ''\r\n  filters.sort = (q.sort as string) || 'newest'\r\n  filters.page = 1\r\n  await load(1)\r\n})\r\n\r\nawait loadCategories()\r\nawait load(1)\r\n\r\nfunction handleSearch(keyword: string): void {\r\n  filters.keyword = keyword\r\n  load(1)\r\n}\r\n\r\nfunction handleFilterChange(newFilters: { category_id: number | ''; sort: string }): void {\r\n  filters.category_id = newFilters.category_id\r\n  filters.sort = newFilters.sort\r\n  load(1)\r\n}\r\n\r\nfunction handleProductClick(product: Product): void {\r\n  navigateTo(`/product/${product.id}`)\r\n}\r\n\r\nfunction handleAddToCart(product: Product): void {\r\n  ElMessage.success(`已将「${product.name}」加入购物车`)\r\n}\r\n</script>"],"version":3}