AAA;AAAA,wBAFD,MAAK;AAAA,wBAAU,MAAK;AAAA,wBAAQ,OAAA,EAAA,SAAA,OAAA;AAAA,wBAAqB,SAAS,QAAA;AAAA,wBAAU,SAAO;AAAA,sBAAA;yCAAa,MAEnG;AAAA,0CAFmG,OAEnG;AAAA,wBAAA;;;;;;;;;cAIJA,YAGM,OAAA,EAHD,OAAA,EAAA,cAAA,UAAA,aAAA,UAAA,SAAA,UAAA,EAAA,GAA6D;AAAA,gCAAC,UAEjE;AAAA,gBAAAA,YAAiF,qBAAA;AAAA,kBAAvE,IAAG;AAAA,kBAAY,OAAA,EAAA,SAAA,WAAA,eAAA,MAAA;AAAA,gBAAA;mCAAyC,MAAI;AAAA,oCAAJ,MAAI;AAAA,kBAAA;;;;cAGxEA,YAAc,qBAAA;AAAA,cACdA,YAEM,OAAA,EAFD,OAAA,EAAA,cAAA,UAAA,aAAA,UAAA,SAAA,UAAA,EAAA,GAA8D,gDAEnE;AAAA,YAAA;AAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_","_scopeId","_ssrRenderComponent","_createVNode"],"sources":["../../../../pages/login.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-page\">\r\n    <el-card class=\"login-card\" shadow=\"always\">\r\n      <h2 style=\"text-align: center; margin-bottom: 8px\">欢迎回来</h2>\r\n      <p style=\"text-align: center; color: #909399; margin-bottom: 32px\">MallShop 商城系统</p>\r\n\r\n      <el-form :model=\"form\" :rules=\"rules\" ref=\"formRef\" @keydown.enter=\"handleLogin\">\r\n        <el-form-item prop=\"username\">\r\n          <el-input v-model=\"form.username\" size=\"large\" placeholder=\"用户名\" prefix-icon=\"User\" />\r\n        </el-form-item>\r\n        <el-form-item prop=\"password\">\r\n          <el-input v-model=\"form.password\" type=\"password\" size=\"large\" placeholder=\"密码\"\r\n            prefix-icon=\"Lock\" show-password />\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" size=\"large\" style=\"width: 100%\" :loading=\"loading\" @click=\"handleLogin\">\r\n            登 录\r\n          </el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n\r\n      <div style=\"text-align: center; font-size: 0.9rem; color: #606266\">\r\n        还没有账号？\r\n        <NuxtLink to=\"/register\" style=\"color: #c0392b; font-weight: 500\">立即注册</NuxtLink>\r\n      </div>\r\n\r\n      <el-divider />\r\n      <div style=\"text-align: center; font-size: 0.8rem; color: #c0c4cc\">\r\n        管理员: admin / admin123 &nbsp;|&nbsp; 用户: test / test123\r\n      </div>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { ref, reactive } from 'vue'\r\nimport { useRoute } from '#app'\r\nimport { useUserStore } from '~/stores/user'\r\nimport { useCartStore } from '~/stores/cart'\r\nimport { ElMessage } from 'element-plus'\r\n\r\nconst route = useRoute()\r\nconst userStore = useUserStore()\r\nconst cartStore = useCartStore()\r\nconst formRef = ref()\r\nconst loading = ref<boolean>(false)\r\n\r\nuseSeoMeta({\r\n  title: '登录 - MallShop',\r\n  description: '登录 MallShop 商城系统'\r\n})\r\n\r\nconst form = reactive({ username: '', password: '' })\r\nconst rules = {\r\n  username: [{ required: true, message: '请输入用户名', trigger: 'blur' }],\r\n  password: [{ required: true, message: '请输入密码', trigger: 'blur' }]\r\n}\r\n\r\nasync function handleLogin(): Promise<void> {\r\n  await formRef.value.validate()\r\n  loading.value = true\r\n  const res = await userStore.login(form)\r\n  if (res.code === 200) {\r\n    useCookie('mall_token').value = res.data.token\r\n    useCookie('mall_user').value = JSON.stringify(res.data.user)\r\n    ElMessage.success('登录成功')\r\n    await cartStore.fetch()\r\n    const redirect = (route.query.redirect as string) || (res.data.user.role === 'admin' ? '/admin' : '/')\r\n    navigateTo(redirect)\r\n  } else {\r\n    ElMessage.error(res.message || '登录失败')\r\n  }\r\n  loading.value = false\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-page {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n}\r\n\r\n.login-card {\r\n  width: 420px;\r\n  border-radius: 16px;\r\n  padding: 20px;\r\n}\r\n</style>"],"version":3}